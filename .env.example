# Azure Event Hubs
EVENT_HUB_CONNECTION_STRING=
EVENT_HUB_NAME=
EVENT_HUB_CONSUMER_GROUP=$Default

# Databricks / ADLS Gen2
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=
DATABRICKS_WORKSPACE_URL=
DATABRICKS_TOKEN=
DATABRICKS_CLUSTER_ID=

# MongoDB Atlas
MONGODB_URI=
MONGODB_DATABASE=omnistream
MONGODB_COLLECTION=anomalies

# Simulator
SIMULATOR_VEHICLE_COUNT=5000
SIMULATOR_EVENT_RATE_PER_SECOND=100
SIMULATOR_BATCH_SIZE=100
SIMULATOR_SEED=42
SIMULATOR_ENABLE_NOISE=true

# Lakehouse paths
DELTA_BASE_PATH=./lakehouse
BRONZE_PATH=./lakehouse/bronze
SILVER_PATH=./lakehouse/silver
GOLD_PATH=./lakehouse/gold
CHECKPOINT_PATH=./lakehouse/checkpoints

# ML
MODEL_PATH=./artifacts/isolation_forest.joblib
ML_RANDOM_STATE=42
ANOMALY_CONTAMINATION=0.02
